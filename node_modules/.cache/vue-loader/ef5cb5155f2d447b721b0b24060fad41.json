{"remainingRequest":"C:\\Users\\Lucyl\\gamedev-portfolio\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!C:\\Users\\Lucyl\\gamedev-portfolio\\src\\views\\Resume.vue?vue&type=script&lang=ts&","dependencies":[{"path":"C:\\Users\\Lucyl\\gamedev-portfolio\\src\\views\\Resume.vue","mtime":1773547752899},{"path":"C:\\Users\\Lucyl\\gamedev-portfolio\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1764763119170},{"path":"C:\\Users\\Lucyl\\gamedev-portfolio\\node_modules\\ts-loader\\index.js","mtime":1764763116841},{"path":"C:\\Users\\Lucyl\\gamedev-portfolio\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1764763119170},{"path":"C:\\Users\\Lucyl\\gamedev-portfolio\\node_modules\\vue-loader\\lib\\index.js","mtime":1764763116820}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["Resume.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAoHA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA","file":"Resume.vue","sourceRoot":"src/views","sourcesContent":["<template>\r\n  <div>\r\n    <h1>Resume</h1>\r\n\r\n    <div class=\"paragraph\">\r\n        I'm <strong>Gage Loyst</strong>, a 22-year-old solo game developer with 5 years of volunteer experience testing pre-release Electronic Arts titles. Experienced in making gameplay systems, level design, and quality assurance, including bug tracking, issue reproduction, and gameplay feedback. Hands-on Unity and C# game developer with multiple projects showing a variety of skills. Seeking an entry-level role to support high-quality game releases.\r\n        <br />Ive been making mods and my own little games since I was a kid and I love every part of the process from design to coding to testing.\r\n        <br />\r\n        <br />Right now I'm trying to work my way up and get into the games industry professionally, so feel free to to contact me via email or discord for any opportunity paid or not.\r\n        <router-link to=\"/contact\">contact me</router-link>.\r\n        <br />\r\n\r\n        <div style=\"margin-top:20px; margin-bottom:20px;\">\r\n            <a class=\"download-link\" href=\"d/resume-en.pdf\" target=\"_blank\"><i class=\"fa fa-download fa-lg fa-fw\"></i> Download as PDF 🇬🇧</a>\r\n            <a class=\"download-link\" href=\"d/cv-fr.pdf\" target=\"_blank\"><i class=\"fa fa-download fa-lg fa-fw\"></i> Télécharger en PDF 🇫🇷</a>\r\n            <div style=\"clear:both\"></div>\r\n        </div>\r\n    </div>\r\n    <div class=\"photo\">\r\n      <img src=\"img/avatest.jpg\" alt=\"Photo of John\" />\r\n    </div>\r\n\r\n    <div style=\"clear:both\"></div>\r\n\r\n    <div class=\"full-content\">\r\n        <h2>Work experience</h2>\r\n\r\n        <h3>Lead Level Designer (Remote, Volunteer)</h3>\r\n        <h4>2025-Now</h4>\r\n\r\n        <div>\r\n            Lead level design for an indie horror game, creating engaging and immersive environments.\r\n            Collaborated with the development team to implement gameplay mechanics and narrative elements.\r\n            Designed and iterated on level layouts, puzzles, and enemy placements to enhance player experience.\r\n            Led a team of level designers, providing guidance and feedback to ensure cohesive design across the game.\r\n            Leveraged strong communication and organizational skills to manage project timelines and deliver high-quality levels on schedule.\r\n        </div>\r\n\r\n        <h3>Electronic Arts Playtester (Remote, Volunteer)</h3>\r\n        <h4>2020-2025</h4>\r\n\r\n        <div>\r\n            Tested pre-release game builds.\r\n            Identified functionality and usability issues.\r\n            Documented detailed feedback to assist development teams.\r\n            Collaborated with cross-functional teams to refine gameplay experience.\r\n            Developed strong skills in reproducibility, bug, documentation and gameplay balancing feedback.\r\n        </div>\r\n\r\n        <h2>Education</h2>\r\n\r\n        <h3>Complete Unity 2D Developer: Create Your Own 2D Games Using Unity C#</h3>\r\n        <h4>Instructor: Rick Davidson</h4>\r\n\r\n        <div>\r\n            Full course on Unity 2D game development covering C# programming, game mechanics, physics, animations, UI, and everything else needed to make multiple full 2D games from scratch.\r\n        </div>\r\n\r\n        <div style=\"margin-top:10px;\">\r\n            <a class=\"download-link\" href=\"d/certificateunity.pdf\" target=\"_blank\"><i class=\"fa fa-certificate fa-lg fa-fw\"></i> View Unity course certificate</a>\r\n            <div style=\"clear:both\"></div>\r\n        </div>\r\n\r\n        <h2>Skills</h2>\r\n\r\n        <div class=\"skill-set\">\r\n            <h3>Languages</h3>\r\n            <SkillRate name=\"C#\" />\r\n            <SkillRate name=\"C++\" />\r\n            <SkillRate name=\"HTML\" />\r\n        </div>\r\n\r\n        <div class=\"skill-set\">\r\n            <h3>Gamedev</h3>\r\n            <SkillRate name=\"Unity 5/6\" />\r\n            <SkillRate name=\"Unreal 5\" />\r\n            <SkillRate name=\"Photoshop\" />\r\n            <SkillRate name=\"Illustrator\" />\r\n            <SkillRate name=\"Audacity\" />\r\n            <SkillRate name=\"FL Studio\" />\r\n            <SkillRate name=\"Blender\" />\r\n            <SkillRate name=\"Radiant (COD Zombies map editor)\" />\r\n        </div>\r\n\r\n        <div class=\"skill-set\">\r\n            <h3>Tools & Frameworks</h3>\r\n            <SkillRate name=\"Visual Studio\" />\r\n            <SkillRate name=\"JetBrains Rider\" />\r\n            <SkillRate name=\"Jira/Trello basic-knowledge\" />\r\n            <SkillRate name=\"Git/SVN/HG\" />\r\n        </div>\r\n        <div style=\"clear:both\" />\r\n\r\n        <h2>Languages</h2>\r\n\r\n        <h3>English</h3>\r\n        <div>Born/live in Canada and have spoken english my whole life.</div>\r\n\r\n        <h2>Besides...</h2>\r\n        <div>\r\n            <h3>I ❤️ Games</h3>\r\n            <div>Video games have been a huge part of my life since I was alittle kid. I played Mario and Nintendo games till I Was about 10 and saw my cousin playing COD World at war zombies and it absolutely amazed me. Ever since i've been playing games like fallout, the binding of isaac, call of duty, borderlands and so so many more small and big games as I love trying different types of games out. </div>\r\n\r\n            <h3>I 🧡 Music</h3>\r\n            <div>I used to and still do make music and it has a huge place in my heart. I mainly produce and do instrumental things but i've done some vocal stuff along with that and id say im a pretty capable digital musician.</div>\r\n\r\n            <h3>I 💛 Comics</h3>\r\n            <div>The worlds they create have always amazed me. Some of my favorite comics are Spawn, Deadpool, Magik and Naruto.</div>\r\n\r\n\r\n        </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script lang=\"ts\">\r\nimport Vue from \"vue\";\r\nimport SkillRate from \"@/components/SkillRate.vue\";\r\n\r\nexport default Vue.extend({\r\n  name: \"Resume\",\r\n  components: {\r\n    SkillRate,\r\n  },\r\n});\r\n</script>\r\n\r\n<style scoped>\r\nh2 {\r\n  font-weight: 100;\r\n  font-size: 2em;\r\n  margin: 0px;\r\n  padding: 0px;\r\n  padding-top: 50px;\r\n}\r\nh3 {\r\n  font-weight: 100;\r\n  font-size: 1.6em;\r\n  margin: 0px;\r\n  padding: 0px;\r\n  padding-top: 30px;\r\n}\r\nh4 {\r\n  font-weight: 100;\r\n  font-size: 1.3em;\r\n  margin: 0px;\r\n  padding: 0px;\r\n  padding-top: 15px;\r\n  font-style: italic;\r\n}\r\n\r\n.paragraph {\r\n  max-width: 700px;\r\n}\r\n\r\n.download-link {\r\n  float:left;\r\n  margin-right: 50px;\r\n}\r\n\r\n.full-content div {\r\n  max-width: 800px;\r\n}\r\n\r\n.skill-set h3 {\r\n  padding-bottom: 10px;\r\n}\r\n\r\n.photo img {\r\n  height: 300px;\r\n  width: 300px;\r\n}\r\n\r\n.tech-stack {\r\n  font-style: italic;\r\n}\r\n\r\n.photo {\r\n  margin-top: 50px;\r\n  text-align: center;\r\n}\r\n\r\n@media only screen and (min-width: 620px){\r\n  .paragraph {\r\n    float: left;\r\n  }\r\n\r\n  .photo {\r\n    float: left;\r\n    padding: 30px;\r\n    padding-left: 80px;\r\n  }\r\n\r\n  .skill-set {\r\n    float: left;\r\n    padding-right: 60px; \r\n  }\r\n}\r\n</style>"]}]}