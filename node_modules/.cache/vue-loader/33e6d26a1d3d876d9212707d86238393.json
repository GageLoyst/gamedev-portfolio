{"remainingRequest":"C:\\Users\\Lucyl\\gamedev-portfolio\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!C:\\Users\\Lucyl\\gamedev-portfolio\\src\\components\\ProjectsList.vue?vue&type=style&index=0&id=0b85af30&scoped=true&lang=css&","dependencies":[{"path":"C:\\Users\\Lucyl\\gamedev-portfolio\\src\\components\\ProjectsList.vue","mtime":1765538343935},{"path":"C:\\Users\\Lucyl\\gamedev-portfolio\\node_modules\\css-loader\\dist\\cjs.js","mtime":1764763118957},{"path":"C:\\Users\\Lucyl\\gamedev-portfolio\\node_modules\\vue-loader\\lib\\loaders\\stylePostLoader.js","mtime":1764763116964},{"path":"C:\\Users\\Lucyl\\gamedev-portfolio\\node_modules\\postcss-loader\\src\\index.js","mtime":1764763117713},{"path":"C:\\Users\\Lucyl\\gamedev-portfolio\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1764763119170},{"path":"C:\\Users\\Lucyl\\gamedev-portfolio\\node_modules\\vue-loader\\lib\\index.js","mtime":1764763116820}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["ProjectsList.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA2GA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA","file":"ProjectsList.vue","sourceRoot":"src/components","sourcesContent":["<template>\r\n    <div>\r\n      <div class=\"projects-list\">\r\n        <template v-for=\"project in projects\">\r\n          <div\r\n            :key=\"project.id\"\r\n              @click=\"showDetails(project)\"\r\n              class=\"project-item\"\r\n              :class=\"{ 'wide': project.isWide, 'high': project.isHigh, 'below-title': enableFullscreen }\">\r\n            <div class=\"project-item-image\" :style=\"{ 'background-image': 'url(' + project.iconUrl + ')' }\" @click=\"onImageClick && onImageClick($event, project.iconUrl)\">\r\n            </div>\r\n            <div class=\"title-bar\" :style=\"{ 'background-color': project.accentColor + 'DD' }\">\r\n                <div class=\"title-text\">\r\n                  {{ project.name }}\r\n                </div>\r\n              </div>\r\n          </div>\r\n        </template>\r\n      </div>\r\n\r\n      <ProjectDetailsOverlay\r\n        v-on:close=\"showPopup = false\"\r\n        :visible=\"showPopup\"\r\n        :title=\"popupTitle\"\r\n        :htmlContent=\"popupContent\"\r\n        :color=\"popupColor\"\r\n      />\r\n\r\n      <!-- Fullscreen overlay (only when enabled and url set) -->\r\n      <div v-if=\"enableFullscreen && fullscreenImageUrl\" ref=\"fsOverlay\" class=\"fs-overlay\" @click=\"closeFullscreen\">\r\n        <img :src=\"fullscreenImageUrl\" class=\"fs-image\" />\r\n      </div>\r\n    </div>\r\n</template>\r\n\r\n<script lang=\"ts\">\r\nimport Vue from \"vue\";\r\nimport ProjectDetailsOverlay from \"@/components/ProjectDetailsOverlay.vue\";\r\nimport ProjectData from \"@/data/ProjectData.ts\";\r\n\r\nexport default Vue.extend({\r\n  name: \"ProjectsList\",\r\n  components: {\r\n    ProjectDetailsOverlay,\r\n  },\r\n  props: {\r\n    projects: Array,\r\n    enableFullscreen: {\r\n      type: Boolean,\r\n      default: false\r\n    }\r\n  },\r\n  data: function () {\r\n    return {\r\n      showPopup: false,\r\n      popupTitle: \"\",\r\n      popupColor: \"\",\r\n      popupContent: \"\",\r\n      fullscreenImageUrl: null as string | null\r\n    };\r\n  },\r\n  mounted() {\r\n    document.addEventListener('fullscreenchange', this.onFsChange);\r\n  },\r\n  beforeDestroy() {\r\n    document.removeEventListener('fullscreenchange', this.onFsChange);\r\n  },\r\n  methods: {\r\n    showDetails: function (item: ProjectData) {\r\n      this.popupTitle = item.name;\r\n      this.popupColor = item.accentColor;\r\n      this.popupContent = item.htmlDescription;\r\n      this.showPopup = true;\r\n      window.scrollTo(0,0);\r\n    },\r\n    onImageClick(event: Event, url: string) {\r\n      if (!this.enableFullscreen) return;\r\n      event.stopPropagation();\r\n      this.openFullscreen(url);\r\n    },\r\n    openFullscreen(url: string) {\r\n      if (!this.enableFullscreen) return;\r\n      this.fullscreenImageUrl = url;\r\n      this.$nextTick(() => {\r\n        const el = this.$refs.fsOverlay as HTMLElement | undefined;\r\n        if (el && (el as any).requestFullscreen) {\r\n          (el as any).requestFullscreen().catch(() => void 0);\r\n        }\r\n      });\r\n    },\r\n    closeFullscreen() {\r\n      if (document.fullscreenElement) {\r\n        document.exitFullscreen().catch(() => void 0);\r\n      }\r\n      this.fullscreenImageUrl = null;\r\n    },\r\n    onFsChange() {\r\n      if (!document.fullscreenElement) {\r\n        this.fullscreenImageUrl = null;\r\n      }\r\n    }\r\n  },\r\n});\r\n</script>\r\n\r\n<style scoped>\r\n\r\n.project-item {\r\n  margin-bottom: 20px;\r\n  width: 100%;\r\n  cursor: pointer;\r\n  position: relative;\r\n  overflow: hidden;\r\n}\r\n\r\n/* Default image + title behavior: title overlays bottom of image */\r\n.project-item-image {\r\n  background-size: cover;\r\n  background-position: center;\r\n  height: 100%;\r\n  width: 100%;\r\n  transition: all 0.2s;\r\n}\r\n.project-item-image:hover {\r\n  -webkit-transform: scale(1.1);\r\n  -ms-transform: scale(1.1);\r\n  transform: scale(1.1);\r\n}\r\n\r\n.project-item:hover {\r\n  filter: brightness(120%);\r\n}\r\n\r\n.title-bar {\r\n  position: absolute;\r\n  bottom: 0px;\r\n  width: 100%;\r\n  background-color: #222222;\r\n}\r\n\r\n.title-text {\r\n  padding: 10px;\r\n}\r\n\r\n/* When below-title class is present, place title below image so it doesn't cover it */\r\n.project-item.below-title {\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n.project-item.below-title .project-item-image {\r\n  /* use aspect-ratio for consistent size */\r\n  width: 100%;\r\n  aspect-ratio: 16 / 9;\r\n}\r\n.project-item.below-title .title-bar {\r\n  position: static;\r\n}\r\n\r\n/* Fullscreen overlay styles */\r\n.fs-overlay {\r\n  position: fixed;\r\n  inset: 0;\r\n  background: rgba(0,0,0,0.95);\r\n  z-index: 9999;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  cursor: zoom-out;\r\n}\r\n.fs-image {\r\n  max-width: 95vw;\r\n  max-height: 95vh;\r\n  object-fit: contain;\r\n  box-shadow: 0 0 30px rgba(0,0,0,0.6);\r\n}\r\n\r\n@media only screen and (min-width: 620px){\r\n  .projects-list {\r\n    max-width: 900px;\r\n    display: grid;\r\n    grid-template-columns: repeat(3, 1fr);\r\n    grid-gap: 20px;\r\n    grid-auto-rows: minmax(250px, auto);\r\n  }\r\n\r\n  .project-item {\r\n    margin: 0px;\r\n    height: 100%;\r\n    width: 100%;\r\n  }\r\n\r\n  .wide {\r\n    grid-column-end: span 2;\r\n  }\r\n  .high {\r\n    grid-row-end: span 2;\r\n  }\r\n}\r\n\r\n</style>"]}]}