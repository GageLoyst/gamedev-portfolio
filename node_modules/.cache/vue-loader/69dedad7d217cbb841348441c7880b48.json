background-image': 'url(' + project.iconUrl + ')' }\">\r\n            </div>\r\n            <!-- moved title bar below image so it doesn't cover the image -->\r\n            <div class=\"title-bar\" :style=\"{ 'background-color': project.accentColor + 'DD' }\">\r\n                <div class=\"title-text\">\r\n                  {{ project.name }}\r\n                </div>\r\n            </div>\r\n          </div>\r\n        </template>\r\n      </div>\r\n\r\n      <!-- If fullscreen mode is enabled for this page, show fullscreen viewer instead of the overlay -->\r\n      <div v-if=\"enableImageFullscreen\">\r\n        <div v-if=\"isFullscreen\" class=\"fullscreen-image\" @click=\"exitFullscreen\">\r\n          <img :src=\"fullscreenUrl\" alt=\"fullscreen image\" />\r\n        </div>\r\n      </div>\r\n\r\n      <ProjectDetailsOverlay\r\n        v-if=\"!enableImageFullscreen\"\r\n        v-on:close=\"showPopup = false\"\r\n        :visible=\"showPopup\"\r\n        :title=\"popupTitle\"\r\n        :htmlContent=\"popupContent\"\r\n        :color=\"popupColor\"\r\n      />\r\n    </div>\r\n</template>\r\n\r\n<script lang=\"ts\">\r\nimport Vue from \"vue\";\r\nimport ProjectDetailsOverlay from \"@/components/ProjectDetailsOverlay.vue\";\r\nimport ProjectData from \"@/data/ProjectData\";\r\n\r\nexport default Vue.extend({\r\n  name: \"ProjectsList\",\r\n  components: {\r\n    ProjectDetailsOverlay,\r\n  },\r\n  props: {\r\n    projects: Array,\r\n    enableImageFullscreen: {\r\n      type: Boolean,\r\n      default: false,\r\n    },\r\n  },\r\n  data: function () {\r\n    return {\r\n      showPopup: false,\r\n      popupTitle: \"\",\r\n      popupColor: \"\",\r\n      popupContent: \"\",\r\n      isFullscreen: false,\r\n      fullscreenUrl: \"\",\r\n    };\r\n  },\r\n  methods: {\r\n    showDetails: function (item: ProjectData) {\r\n      if (this.enableImageFullscreen) {\r\n        // open the project's thumbnail in fullscreen\r\n        this.enterFullscreen(item.iconUrl);\r\n        return;\r\n      }\r\n\r\n      this.popupTitle = item.name;\r\n      this.popupColor = item.accentColor;\r\n      this.popupContent = item.htmlDescription;\r\n      this.showPopup = true;\r\n      window.scrollTo(0,0);\r\n    },\r\n    enterFullscreen(url: string) {\r\n      this.fullscreenUrl = url;\r\n      this.isFullscreen = true;\r\n      document.body.style.overflow = 'hidden';\r\n    },\r\n    exitFullscreen() {\r\n      this.isFullscreen = false;\r\n      this.fullscreenUrl = '';\r\n      document.body.style.overflow = '';\r\n    },\r\n    handleKeydown(event: KeyboardEvent) {\r\n      if (this.isFullscreen && event.key === 'Escape') {\r\n        this.exitFullscreen();\r\n      }\r\n    }\r\n  },\r\n  mounted() {\r\n    window.addEventListener('keydown', this.handleKeydown);\r\n  },\r\n  beforeDestroy() {\r\n    window.removeEventListener('keydown', this.handleKeydown);\r\n    document.body.style.overflow = '';\r\n  }\r\n});\r\n</script>\r\n\r\n<style scoped>\r\n\r\n.project-item {\r\n  /* no fixed overall height; image will define height */\r\n  margin-bottom: 20px;\r\n  width: 100%;\r\n  cursor: pointer;\r\n  position: relative;\r\n  overflow: hidden;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.project-item-image {\r\n  background-size: cover;\r\n  background-position: center;\r\n  height: 300px; /* image area height */\r\n  width: 100%;\r\n  transition: all 0.2s;\r\n}\r\n.project-item-image:hover {\r\n  -webkit-transform: scale(1.1);\r\n  -ms-transform: scale(1.1);\r\n  transform: scale(1.1);\r\n}\r\n\r\n.project-item:hover {\r\nfilter: brightness(120%);\r\n}\r\n\r\n/* title bar moved below image; no absolute positioning */\r\n.title-bar {\r\n  width: 100%;\r\n  background-color: #222222;\r\n}\r\n\r\n.title-text {\r\n  padding: 10px;\r\n}\r\n\r\n    @media only screen and (min-width: 620px) {\r\n        .projects-list {\r\n            max-width: 900px;\r\n            display: grid;\r\n            grid-template-columns: repeat(3, 1fr);\r\n            grid-gap: 20px;\r\n            grid-auto-rows: minmax(250px, auto);\r\n        }\r\n\r\n        .wide {\r\n            grid-column: 1 / span 2;\r\n        }\r\n\r\n        .high {\r\n            grid-row-end: span 2;\r\n        }\r\n    }\r\n\r\n\r\n/* Fullscreen image viewer styles */\r\n.fullscreen-image {\r\n  position: fixed;\r\n  z-index: 1000;\r\n  top: 0;\r\n  left: 0;\r\n  right: 0;\r\n  bottom: 0;\r\n  background-color: rgba(0,0,0,0.95);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  cursor: zoom-out;\r\n}\r\n.fullscreen-image img {\r\n  max-width: 100%;\r\n  max-height: 100%;\r\n}\r\n\r\n</style>"]}]}