:20px; margin-bottom:20px;\">\r\n            <a class=\"download-link\" href=\"d/resume-en.pdf\" target=\"_blank\"><i class=\"fa fa-download fa-lg fa-fw\"></i> Download as PDF 🇬🇧</a>\r\n            <a class=\"download-link\" href=\"d/cv-fr.pdf\" target=\"_blank\"><i class=\"fa fa-download fa-lg fa-fw\"></i> Télécharger en PDF 🇫🇷</a>\r\n            <div style=\"clear:both\"></div>\r\n        </div>\r\n    </div>\r\n    <div class=\"photo\">\r\n      <img src=\"img/avatest.jpg\" alt=\"Photo of John\" />\r\n    </div>\r\n\r\n    <div style=\"clear:both\"></div>\r\n\r\n    <div class=\"full-content\">\r\n        <h2>Work experience</h2>\r\n\r\n        <h3>Electronic Arts Playtester (Remote, Volunteer)</h3>\r\n        <h4>2020-2025</h4>\r\n\r\n        <div>\r\n            Tested pre-release game builds.\r\n            Identified functionality and usability issues.\r\n            Documented detailed feedback to assist development teams.\r\n            Collaborated with cross-functional teams to refine gameplay experience.\r\n            Developed strong skills in reproducibility, bug, documentation and gameplay balancing feedback.\r\n        </div>\r\n\r\n        <h2>Skills</h2>\r\n\r\n        <div class=\"skill-set\">\r\n            <h3>Languages</h3>\r\n            <SkillRate name=\"C#\" />\r\n            <SkillRate name=\"C++\" />\r\n        </div>\r\n\r\n        <div class=\"skill-set\">\r\n            <h3>Gamedev</h3>\r\n            <SkillRate name=\"Unity 5/6\" />\r\n            <SkillRate name=\"Unreal 5\" />\r\n            <SkillRate name=\"Photoshop\" />\r\n            <SkillRate name=\"Illustrator\" />\r\n            <SkillRate name=\"Audacity\" />\r\n            <SkillRate name=\"FL Studio\" />\r\n            <SkillRate name=\"Blender\" />\r\n            <SkillRate name=\"Radiant (COD Zombies map editor)\" />\r\n        </div>\r\n\r\n        <div class=\"skill-set\">\r\n            <h3>Tools & Frameworks</h3>\r\n            <SkillRate name=\"Visual Studio\" />\r\n            <SkillRate name=\"JetBrains Rider\" />\r\n            <SkillRate name=\"Jira/Trello basic knowledge\" />\r\n            <SkillRate name=\"Git/SVN/HG\" />\r\n        </div>\r\n        <div style=\"clear:both\" />\r\n\r\n        <h2>Languages</h2>\r\n\r\n        <h3>English</h3>\r\n        <div>Born in Canada and have spoken english my whole life.</div>\r\n\r\n        <h2>Besides...</h2>\r\n        <div>\r\n            <h3>I ❤️ Games</h3>\r\n            <div>Videogames have been a huge part of my life since i was alittle kid.</div>\r\n\r\n            <h3>I 🧡 Music</h3>\r\n            <div>I used to and still do make music and it has a huge place in my heart.</div>\r\n\r\n            <h3>I 💛 Comics</h3>\r\n            <div>The worlds they create have always amazed me.</div>\r\n\r\n\r\n        </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script lang=\"ts\">\r\nimport Vue from \"vue\";\r\nimport SkillRate from \"@/components/SkillRate.vue\";\r\n\r\nexport default Vue.extend({\r\n  name: \"Resume\",\r\n  components: {\r\n    SkillRate,\r\n  },\r\n});\r\n</script>\r\n\r\n<style scoped>\r\nh2 {\r\n  font-weight: 100;\r\n  font-size: 2em;\r\n  margin: 0px;\r\n  padding: 0px;\r\n  padding-top: 50px;\r\n}\r\nh3 {\r\n  font-weight: 100;\r\n  font-size: 1.6em;\r\n  margin: 0px;\r\n  padding: 0px;\r\n  padding-top: 30px;\r\n}\r\nh4 {\r\n  font-weight: 100;\r\n  font-size: 1.3em;\r\n  margin: 0px;\r\n  padding: 0px;\r\n  padding-top: 15px;\r\n  font-style: italic;\r\n}\r\n\r\n.paragraph {\r\n  max-width: 700px;\r\n}\r\n\r\n.download-link {\r\n  float:left;\r\n  margin-right: 50px;\r\n}\r\n\r\n.full-content div {\r\n  max-width: 800px;\r\n}\r\n\r\n.skill-set h3 {\r\n  padding-bottom: 10px;\r\n}\r\n\r\n.photo img {\r\n  height: 300px;\r\n  width: 300px;\r\n}\r\n\r\n.tech-stack {\r\n  font-style: italic;\r\n}\r\n\r\n.photo {\r\n  margin-top: 50px;\r\n  text-align: center;\r\n}\r\n\r\n@media only screen and (min-width: 620px){\r\n  .paragraph {\r\n    float: 