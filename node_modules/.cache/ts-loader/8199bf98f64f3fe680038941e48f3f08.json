e used in other pages\r\nHelpers.preloadImages([\r\n  \"img/projects/project-1-icon.png\",\r\n  \"img/projects/project-2-icon.png\",\r\n  \"img/projects/project-3-icon.png\"\r\n]);\r\n\r\n"]}]}