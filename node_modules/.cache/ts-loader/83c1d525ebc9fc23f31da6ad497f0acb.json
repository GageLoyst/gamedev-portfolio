AjCD,IAiCC","sourcesContent":["export default class ProjectData {\r\n    id: string;\r\n    name: string;\r\n    htmlDescription: string;\r\n    iconUrl: string; // used as thumnail\r\n    isWide: boolean; // thumbnail will take 2 cols in the grid view\r\n    isHigh: boolean; // thumbnail will take 2 rows in the grid view\r\n    accentColor: string; // color of title bar \r\n\r\n    constructor(id: string, name: string, iconUrl: string, html: string, accentColor = \"#000000\", isHigh = false, isWide = false){\r\n        this.id = id;\r\n        this.name = name;\r\n        // normalize icon url: if it's a relative path starting with \"img/\", make it absolute from root\r\n        if (iconUrl && typeof iconUrl === 'string' && !iconUrl.match(/^https?:\\/\\//) && !iconUrl.startsWith('/')){\r\n            this.iconUrl = '/' + iconUrl;\r\n        } else {\r\n            this.iconUrl = iconUrl;\r\n        }\r\n\r\n        // normalize image src paths inside html description (img paths should be absolute from root)\r\n        if (html && typeof html === 'string'){\r\n            // replace src=\"img/... and src='img/... with src=\"/img/... and src='/img/...\r\n            this.htmlDescription = html.replace(/src=\\\"img\\//g, 'src=\"/img/').replace(/src=\\'img\\//g, \"src='/img/\");\r\n            // also replace any href or other attributes that reference img/ without leading slash\r\n            this.htmlDescription = this.htmlDescription.replace(/href=\\\"img\\//g, 'href=\"/img/').replace(/href=\\'img\\//g, \"href='/img/\");\r\n        } else {\r\n            this.htmlDescription = html;\r\n        }\r\n\r\n        this.isHigh = isHigh;\r\n        this.isWide = isWide;\r\n        this.accentColor = accentColor;\r\n    }\r\n}\r\n"]}]}