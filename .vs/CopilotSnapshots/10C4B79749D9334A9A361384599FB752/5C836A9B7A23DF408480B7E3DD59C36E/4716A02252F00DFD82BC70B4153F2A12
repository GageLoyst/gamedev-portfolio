<template>
  <transition name="fade">
    <div v-if="visible">
      <div class="overlay"></div>
      <div class="dialog" :style="{ 'background-color': color }">
        <h1 class="dialog-title">{{ title }}</h1>
        <div @click="$emit('close')" class="dialog-close"><i class="fa fa-times fa-lg fa-fw"></i></div>
        <div class="dialog-content">
          <!-- wrapper to capture/inject listeners on images inserted via v-html -->
          <div class="html-content" v-html="htmlContent" @click="onContentClick"></div>
          <div class="dialog-bottom">
            <a @click="$emit('close')" class="dialog-close-button">Close</a>
          </div>
        </div>
      </div>

      <!-- fullscreen image overlay shown when an image is clicked and allowFullScreen is true -->
      <div v-if="fullScreenVisible" class="image-overlay" @click="closeFullScreen">
        <img :src="fullScreenImageUrl" alt="Full screen" />
      </div>
    </div>
  </transition>
</template>

<script lang="ts">
import Vue from "vue";

export default Vue.extend({
  name: "ProjectDetailsOverlay",
  props: {
    visible: Boolean,
    color: String,
    title: String,
    htmlContent: String,
    allowFullScreen: {
      type: Boolean,
      default: false,
    },
  },
  data() {
    return {
      fullScreenVisible: false,
      fullScreenImageUrl: "",
      __docClickHandler: null as any
    };
  },
  watch: {
    visible(newVal: boolean) {
      if (newVal && this.allowFullScreen) {
        // attach robust document-level listener to catch images inside v-html
        this.attachDocListener();
      } else {
        this.detachDocListener();
        this.detachImageListeners();
        this.fullScreenVisible = false;
        this.fullScreenImageUrl = "";
      }
    }
  },
  beforeDestroy() {
    this.detachDocListener();
    this.detachImageListeners();
  },
  methods: {
    onContentClick(event: Event) {
      // keep delegated click as fallback
      if (!this.allowFullScreen) return;
      const target = event.target as HTMLElement | null;
      if (!target) return;
      if (target.tagName === 'IMG') {
        const img = target as HTMLImageElement;
        const src = img.getAttribute('src') || img.src;
        if (src) {
          this.fullScreenImageUrl = src;
          this.fullScreenVisible = true;
        }
      }
    },
    attachImageListeners() {
      const root = this.$el as HTMLElement | null;
      if (!root) return;
      const imgs = root.querySelectorAll('.html-content img');
      imgs.forEach((el) => {
        const fn = (evt: Event) => this.onImageClick(evt);
        (el as any).__fullscreenHandler = fn;
        el.addEventListener('click', fn);
      });
    },
    detachImageListeners() {
      const root = this.$el as HTMLElement | null;
      if (!root) return;
      const imgs = root.querySelectorAll('.html-content img');
      imgs.forEach((el) => {
        const fn = (el as any).__fullscreenHandler;
        if (fn) {
          el.removeEventListener('click', fn);
          try { delete (el as any).__fullscreenHandler; } catch(e) { (el as any).__fullscreenHandler = undefined; }
        }
      });
    },
    onImageClick(event: Event) {
      event.stopPropagation();
      const el = event.currentTarget as HTMLImageElement | null;
      if (!el) return;
      const src = el.getAttribute('src') || el.src;
      if (src) {
        this.fullScreenImageUrl = src;
        this.fullScreenVisible = true;
      }
    },
    attachDocListener() {
      if (this.__docClickHandler) return;
      this.__docClickHandler = (evt: Event) => {
        const target = evt.target as HTMLElement | null;
        if (!target) return;
        // ensure click is inside this component's dialog content
        const dialog = this.$el as HTMLElement | null;
        if (!dialog) return;
        if (!dialog.contains(target)) return;
        // only handle clicks on images inside .html-content
        const img = (target.tagName === 'IMG') ? target as HTMLImageElement : target.closest && target.closest('.html-content img') as HTMLImageElement | null;
        if (img) {
          const src = img.getAttribute('src') || img.src;
          if (src) {
            evt.stopPropagation();
            evt.preventDefault();
            this.fullScreenImageUrl = src;
            this.fullScreenVisible = true;
          }
        }
      };
      document.addEventListener('click', this.__docClickHandler, true);
    },
    detachDocListener() {
      if (this.__docClickHandler) {
        document.removeEventListener('click', this.__docClickHandler, true);
        this.__docClickHandler = null;
      }
    },
    closeFullScreen() {
      this.fullScreenVisible = false;
      this.fullScreenImageUrl = "";
    },
  },
});
</script>

